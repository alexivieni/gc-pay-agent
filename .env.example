# setup-azure.ps1 writes .env for you. To fill it in by hand instead, copy this
# file to .env. .env is in .gitignore: never commit it.

# Foundry portal > your project > Overview > project endpoint
PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>

# The deployment name you gave your chat model when you deployed it
MODEL_DEPLOYMENT=gpt-5-mini

# Name of the agent this project creates and talks to
AGENT_NAME=gc-pay-agent
